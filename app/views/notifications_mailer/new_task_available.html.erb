<% content_for :icon do %>new<% end %>
<% content_for :preheader do %>A new task is now available in <%= @doubtfire_product_name %>.<% end %>
<% content_for :heading do %>New task available<% end %>

<p style="margin:0 0 20px 0;">Hi <%= @user.name %>,</p>
<%= render 'layouts/notification_mail/details', body: @notification.message, category: 'new', label: 'New task' %>
<% if @notification.link.present? %>
  <%= render 'layouts/notification_mail/button', url: "#{@doubtfire_host}#{@notification.link}", label: 'Open the task' %>
<% end %>
<%= render 'layouts/notification_mail/note', body: "Open the task to review its details and when it is due." %>
<% content_for :footer do %>
  <p style="margin:0;">
    You are receiving this because your task notifications are turned on.
    You can change that at <a href="<%= @unsubscribe_url %>" style="color:#6b7280; text-decoration:underline;">your profile</a>.
  </p>
<% end %>
