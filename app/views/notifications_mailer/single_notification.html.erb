<% content_for :icon do %>new<% end %>
<% content_for :preheader do %><%= @notification.message.to_s.truncate(90) %><% end %>
<% content_for :heading do %>You have a new notification<% end %>

<p style="margin:0 0 20px 0;">Hi <%= @user.name %>,</p>
<%= render 'layouts/notification_mail/details', body: @notification.message, category: 'new' %>
<% if @notification.link.present? %>
  <%= render 'layouts/notification_mail/button', url: "#{@doubtfire_host}#{@notification.link}", label: "View in #{@doubtfire_product_name}" %>
<% end %>
<% content_for :footer do %>
  <p style="margin:0;">
    You are receiving this because your notification preferences allow it.
    You can update them at <a href="<%= @unsubscribe_url %>" style="color:#6b7280; text-decoration:underline;">your profile</a>.
  </p>
<% end %>
