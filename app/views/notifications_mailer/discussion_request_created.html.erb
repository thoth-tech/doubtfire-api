<% content_for :icon do %>discuss<% end %>
<% content_for :preheader do %>A discussion prompt is ready for you in <%= @doubtfire_product_name %>.<% end %>
<% content_for :heading do %>Discussion prompt ready<% end %>

<p style="margin:0 0 20px 0;">Hi <%= @user.name %>,</p>
<%= render 'layouts/notification_mail/details', body: @notification.message, category: 'discuss', label: 'Discussion prompt' %>
<% if @notification.link.present? %>
  <%= render 'layouts/notification_mail/button', url: "#{@doubtfire_host}#{@notification.link}", label: 'Open the task' %>
<% end %>
<%= render 'layouts/notification_mail/note', body: "The prompt is not included in this email. Open the task to listen and respond." %>
<% content_for :footer do %>
  <p style="margin:0;">
    You are receiving this because your feedback notifications are turned on.
    You can change that at <a href="<%= @unsubscribe_url %>" style="color:#6b7280; text-decoration:underline;">your profile</a>.
  </p>
<% end %>
