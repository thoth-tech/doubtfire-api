<% section_heading = 'margin:0 0 12px 0; font-size:14px; line-height:1.4; font-weight:600; letter-spacing:0.4px; text-transform:uppercase;' %>
<% content_for :icon do %>summary<% end %>
<% week_range = "#{@summary_stats[:week_start].day.ordinalize} #{@summary_stats[:week_start].strftime("%B %Y")} to #{@summary_stats[:week_end].day.ordinalize} #{@summary_stats[:week_end].strftime("%B %Y")}" %>
<% content_for :preheader do %><%= week_range %><% end %>
<% content_for :heading do %><%= @summary_stats[:unit].name %> - Weekly Summary<% end %>
<% content_for :subheading do %><%= week_range %><% end %>

<p style="margin:0 0 20px 0;">Hi <%= @staff.first_name %>,</p>

<% if @unit_role.has_students? %>
  <%# Lead with the number a tutor has to act on. Everything else in this email
      is a record of the week, this is the only part that is still outstanding. %>
  <% waiting = @data[:tasks_awaiting_feedback_count].to_i %>
  <% oldest = @data[:oldest_task_days].to_i %>
  <% waiting_category = if waiting.zero?
                          'submission'
                        elsif oldest >= 7
                          'due'
                        else
                          'summary'
                        end %>
  <% waiting_summary = capture do %>
    <% if waiting.zero? %>
      <strong style="font-size:20px;">Nothing</strong> is waiting for your feedback.
    <% else %>
      <strong style="font-size:20px;"><%= waiting %></strong>
      task<%= "s" unless waiting == 1 %> <%= are_is(waiting) %> waiting for your feedback.
      The oldest was submitted <strong><%= oldest %> day<%= "s" unless oldest == 1 %></strong> ago.
    <% end %>
  <% end %>
  <%= render 'layouts/notification_mail/details', body: waiting_summary, category: waiting_category, label: 'Waiting on you' %>

  <%# The only link in this email used to be Unsubscribe. It told a tutor how
      many tasks were waiting and gave them no way to reach any of them. %>
  <%= render 'layouts/notification_mail/button', url: "#{@doubtfire_host}/units/#{@unit.id}/tasks/inbox", label: 'Open your marking queue' %>

  <h2 style="<%= section_heading %> color:#6b7280;">Your week</h2>
  <%= render 'layouts/notification_mail/stats', rows: [
        [@data[:received_comments], "comment#{'s' if @data[:received_comments] != 1} and pieces of feedback received"],
        [@data[:sent_comments], "comment#{'s' if @data[:sent_comments] != 1} and pieces of feedback posted"],
        [@data[:staff_engagements], "task#{'s' unless @data[:staff_engagements] == 1} you gave a new status"],
        [@data[:weekly_total_tasks_discussed], "task#{'s' unless @data[:weekly_total_tasks_discussed] == 1} you discussed"],
        [@data[:weekly_engagements_count], "state change#{'s' unless @data[:weekly_engagements_count] == 1} on your students' tasks"]
      ] %>

  <h2 style="<%= section_heading %> color:#6b7280;">Across the unit</h2>
  <%= render 'layouts/notification_mail/stats', rows: [
        [@summary_stats[:unit_week_comments], "text comment#{'s' if @summary_stats[:unit_week_comments] != 1} made"],
        [@summary_stats[:unit_week_engagements], "task state change#{'s' unless @summary_stats[:unit_week_engagements] == 1}"]
      ] %>

  <% if @summary_stats[:revert][@staff].count > 0 %>
    <% revert_list = capture do %>
      <p style="margin:0 0 8px 0;">
        These students have been advised to revert their grade to Pass, because they are falling behind on their pass tasks.
      </p>
      <ul style="margin:0; padding:0 0 0 20px;">
        <% @summary_stats[:revert][@staff].each do |p| %>
          <li style="margin:0 0 4px 0;"><%= p.student.name %></li>
        <% end %>
      </ul>
    <% end %>
    <%= render 'layouts/notification_mail/details', body: revert_list, category: 'due', label: 'Falling behind' %>
  <% end %>
<% else %>
  <p style="margin:0 0 20px 0;">Hope you had a good week. Here is what happened in this unit.</p>
  <%= render 'layouts/notification_mail/stats', rows: [
        [@summary_stats[:unit_week_comments], "text comment#{'s' if @summary_stats[:unit_week_comments] != 1} made in this unit"],
        [@summary_stats[:unit_week_engagements], "task state change#{'s' unless @summary_stats[:unit_week_engagements] == 1} in this unit"]
      ] %>
<% end %>

<% if @unit_role.is_convenor? && !@summary_stats[:tutorial_streams].nil? && !@summary_stats[:tutorial_streams].empty?%>
  <%# Create a table for each tutorial stream %>
  <% @summary_stats[:tutorial_streams].each do |tutorial_stream, tutorial_stream_data | %>
  <% next unless tutorial_stream_data[:stream_linked_to_task_definition] %>
  <h2 style="<%= section_heading %> color:#6b7280;">
    Tutorial stream: <%= tutorial_stream.name %>
  </h2>
  <%# Skip table if no tutorials%>
  <% unless tutorial_stream_data.nil? || tutorial_stream_data[:tutorials].nil?%>
      <div style="overflow-x:auto;"><table role="table" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse; margin:0 0 20px 0; font-size:13px; line-height:1.4;">
          <thead>
              <tr>
                  <th rowspan="2" scope="col" style="width:15%; padding:6px; border-bottom:1px solid #e5e7eb; text-align:left; background-color:#f5f5ff; color:#111827;">Name</th>
                  <th rowspan="2" scope="col" style="width:10%; padding:6px; border-bottom:1px solid #e5e7eb; text-align:left; background-color:#f5f5ff; color:#111827;">Students</th>
                  <th colspan="2" scope="colgroup" style="width:20%; padding:6px; border-bottom:1px solid #e5e7eb; text-align:left; background-color:#f5f5ff; color:#111827;">Assessments</th>
                  <th colspan="2" scope="colgroup" style="width:20%; padding:6px; border-bottom:1px solid #e5e7eb; text-align:left; background-color:#f5f5ff; color:#111827;">Comments</th>
                  <th rowspan="2" scope="col" style="width:15%; padding:6px; border-bottom:1px solid #e5e7eb; text-align:left; background-color:#f5f5ff; color:#111827;">Awaiting Feedback</th>
                  <th rowspan="2" scope="col" style="width:15%; padding:6px; border-bottom:1px solid #e5e7eb; text-align:left; background-color:#f5f5ff; color:#111827;">Oldest Task</th>
                  <th colspan="2" scope="colgroup" style="width:15%; padding:6px; border-bottom:1px solid #e5e7eb; text-align:left; background-color:#f5f5ff; color:#111827;">Discussions</th>
              </tr>
              <tr>
                  <th scope="col" style="padding:6px; border-bottom:1px solid #e5e7eb; text-align:left; background-color:#f5f5ff; color:#111827;">Total</th>
                  <th scope="col" style="padding:6px; border-bottom:1px solid #e5e7eb; text-align:left; background-color:#f5f5ff; color:#111827;">Week</th>
                  <th scope="col" style="padding:6px; border-bottom:1px solid #e5e7eb; text-align:left; background-color:#f5f5ff; color:#111827;">Total</th>
                  <th scope="col" style="padding:6px; border-bottom:1px solid #e5e7eb; text-align:left; background-color:#f5f5ff; color:#111827;">Week</th>
                  <th scope="col" style="padding:6px; border-bottom:1px solid #e5e7eb; text-align:left; background-color:#f5f5ff; color:#111827;">Total</th>
                  <th scope="col" style="padding:6px; border-bottom:1px solid #e5e7eb; text-align:left; background-color:#f5f5ff; color:#111827;">Week</th>
              </tr>
          </thead>
          <tbody>
  <% sorted_data = tutorial_stream_data[:unit_roles].sort_by do |unit_role, data|
     [-data[:oldest_task_days].to_i, -data[:tasks_awaiting_feedback_count].to_i]
   end %>
  <%   sorted_data.each do | unit_role, data | %>
  <%    next unless data[:number_of_students] > 0%>
        <tr>
          <td style="padding:6px; border-bottom:1px solid #f0f0f0;"><%= '%-12s' % unit_role.user.name.truncate(14)  %></td>
          <td style="padding:6px; border-bottom:1px solid #f0f0f0;"><%= '%8i'   % data[:number_of_students] %></td>
          <td style="padding:6px; border-bottom:1px solid #f0f0f0;"><%= '%7i'   % data[:total_staff_engagements] %></td>
          <td style="padding:6px; border-bottom:1px solid #f0f0f0;"><%= '%6i'   % data[:staff_engagements] %></td>
          <td style="padding:6px; border-bottom:1px solid #f0f0f0;"><%= '%5i'   % data[:total_comments].uniq.count %></td>
          <td style="padding:6px; border-bottom:1px solid #f0f0f0;"><%= '%5i'   % data[:sent_comments].uniq.count %></td>
          <td style="padding:6px; border-bottom:1px solid #f0f0f0;"><%= '%8i'   % data[:tasks_awaiting_feedback_count] %></td>
          <td class="<%= 'overdue' unless data[:oldest_task_days] < 7 %>" style="padding:6px; border-bottom:1px solid #f0f0f0;<%= ' background-color:#fde2e1; color:#b42318; font-weight:600;' unless data[:oldest_task_days] < 7 %>"><%= '%6i'   % data[:oldest_task_days] %> days</td>
          <td style="padding:6px; border-bottom:1px solid #f0f0f0;"><%= '%5i'   % data[:total_tasks_discussed] %></td>
          <td style="padding:6px; border-bottom:1px solid #f0f0f0;"><%= '%5i'   % data[:weekly_tasks_discussed] %></td>
        </tr>
  <%   end %>
          </tbody>
      </table></div>
  <%   end %>
    <% if tutorial_stream_data[:num_students_without_tutors] > 0 %>
        <%= render 'layouts/notification_mail/note', body: "#{tutorial_stream_data[:num_students_without_tutors]} student#{"s" unless tutorial_stream_data[:num_students_without_tutors] == 1} #{are_is(tutorial_stream_data[:num_students_without_tutors])} not allocated to a tutorial in this stream. Work submitted by #{this_these(tutorial_stream_data[:num_students_without_tutors])} student#{"s" unless tutorial_stream_data[:num_students_without_tutors] == 1} will not appear in any of the tutor inboxes." %>
    <% end %>
  <% end %>
<% end %>
    <p style="margin:24px 0 0 0;">
        Cheers, <br />
        The <%= @doubtfire_product_name %> Team on behalf of <%= @convenor.name %>
    </p>

<% content_for :footer do %>
  <p style="margin:0;">
    <a href="<%= @unsubscribe_url %>" style="color:#6b7280; text-decoration:underline;">Unsubscribe</a> | Generated with <%= @doubtfire_product_name %>
  </p>
<% end %>
