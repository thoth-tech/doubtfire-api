<% content_for :icon do %>submission<% end %>
<% content_for :preheader do %>This receipt confirms when the submission was received.<% end %>
<% content_for :heading do %>Submission received<% end %>

<p style="margin:0 0 20px 0;">Hi <%= @user.first_name %>,</p>
<%= render 'layouts/notification_mail/details', body: @notification.message, category: 'submission', label: 'Receipt' %>
<% if @notification.link.present? %>
  <%= render 'layouts/notification_mail/button', url: "#{@doubtfire_host}#{@notification.link}", label: "View the current status in #{@doubtfire_product_name}" %>
<% end %>
<%= render 'layouts/notification_mail/note', body: "This receipt confirms when the submission was received. It does not confirm an assessment outcome." %>
<% content_for :footer do %>
  <p style="margin:0;">
    You can manage your notification preferences in
    <a href="<%= @unsubscribe_url %>" style="color:#6b7280; text-decoration:underline;">your profile</a>.
  </p>
<% end %>
