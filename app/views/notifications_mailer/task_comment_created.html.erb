<% content_for :icon do %>comment<% end %>
<% content_for :preheader do %>Open the task in <%= @doubtfire_product_name %> to read it and reply.<% end %>
<% content_for :heading do %>New comment on a task<% end %>

<p style="margin:0 0 20px 0;">Hi <%= @user.name %>,</p>
<%= render 'layouts/notification_mail/details', body: @notification.message, category: 'comment', label: 'New comment' %>
<% if @notification_url.present? %>
  <%= render 'layouts/notification_mail/button', url: @notification_url, label: 'Open the task' %>
<% end %>
<%= render 'layouts/notification_mail/note', body: "The comment is not included in this email. Open the task in #{@doubtfire_product_name} to read it and reply." %>
<% content_for :footer do %>
  <p style="margin:0;">
    You are receiving this because your feedback notifications are turned on.
    You can change that at <a href="<%= @unsubscribe_url %>" style="color:#6b7280; text-decoration:underline;">your profile</a>.
  </p>
<% end %>
