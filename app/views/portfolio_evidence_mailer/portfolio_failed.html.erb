<% content_for :icon do %>alert<% end %>
<% content_for :preheader do %>There was an error compiling your portfolio.<% end %>
<% content_for :heading do %>Your portfolio could not be compiled<% end %>

<p style="margin:0 0 20px 0;">Hi <%= @student.first_name %>,</p>
<%= render 'layouts/notification_mail/details', body: "One of your task PDFs is usually the cause. Open each task PDF and check it, then schedule your portfolio to compile again.", category: 'alert', label: 'What to do' %>

<%= render 'layouts/notification_mail/button', url: "#{@doubtfire_host}/projects/#{@project.id}/portfolio", label: 'Open your portfolio' %>

<% if @project.portfolio_auto_generated %>
  <%= render 'layouts/notification_mail/note', body: "This portfolio was generated for you automatically. You can customise it and recreate it up until the due date your teaching staff set." %>
<% end %>

<p style="margin:24px 0 0 0;">
  Cheers, <br />
  The <%= @doubtfire_product_name %> Team on behalf of <%= @convenor.name %>
</p>

<% content_for :footer do %>
  <p style="margin:0;">
    <a href="<%= @unsubscribe_url %>" style="color:#6b7280; text-decoration:underline;">Unsubscribe</a> | Generated with <%= @doubtfire_product_name %>
  </p>
<% end %>
