<% content_for :icon do %>ready_for_feedback<% end %>
<% content_for :preheader do %>Your submitted evidence is ready to be viewed and assessed.<% end %>
<% content_for :heading do %>Task PDFs ready to view<% end %>
<% content_for :subheading do %><%= @tasks.count %> task<%= "s" unless @tasks.count == 1 %> prepared for your tutor<% end %>

<p style="margin:0 0 20px 0;">Hi <%= @student.first_name %>,</p>
<%= render 'layouts/notification_mail/details', body: "Your evidence has been prepared and is now with your tutor to assess. There is nothing more for you to do on these.", category: 'ready_for_feedback', label: 'Status' %>

<p style="margin:0 0 12px 0; font-size:14px; font-weight:600; letter-spacing:0.4px; text-transform:uppercase; color:#6b7280;">Ready to view</p>
<%= render 'layouts/notification_mail/task_rows', tasks: @tasks, project: @project, host: @doubtfire_host %>

<%= render 'layouts/notification_mail/button', url: "#{@doubtfire_host}/projects/#{@project.id}/dashboard", label: "Open your tasks in #{@doubtfire_product_name}" %>

<p style="margin:24px 0 0 0;">
  Cheers, <br />
  The <%= @doubtfire_product_name %> Team on behalf of <%= @tutor.name %>
</p>

<% content_for :footer do %>
  <p style="margin:0;">
    <a href="<%= @unsubscribe_url %>" style="color:#6b7280; text-decoration:underline;">Unsubscribe</a> | Generated with <%= @doubtfire_product_name %>
  </p>
<% end %>
