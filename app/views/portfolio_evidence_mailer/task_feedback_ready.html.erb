<% content_for :icon do %>feedback<% end %>
<% content_for :preheader do %>Your tutor has checked your tasks and provided feedback.<% end %>
<% content_for :heading do %>Feedback ready to review<% end %>
<% content_for :subheading do %><%= @tasks.count %> task<%= "s" unless @tasks.count == 1 %> checked by <%= @tutor.name %><% end %>

<p style="margin:0 0 20px 0;">Hi <%= @student.first_name %>,</p>
<%= render 'layouts/notification_mail/details', body: "I have checked your tasks and left feedback. Open each one to see its new status#{@has_comments ? ' and read the comments' : ''}.", category: 'feedback', label: 'What to do' %>

<p style="margin:0 0 12px 0; font-size:14px; font-weight:600; letter-spacing:0.4px; text-transform:uppercase; color:#6b7280;">Tasks checked</p>
<%= render 'layouts/notification_mail/task_rows',
      tasks: @tasks,
      project: @project,
      host: @doubtfire_host,
      note_for: ->(task) { task.is_last_comment_by?(@tutor) ? '- with comments' : nil } %>

<%= render 'layouts/notification_mail/button', url: "#{@doubtfire_host}/projects/#{@project.id}/dashboard", label: "Open your tasks in #{@doubtfire_product_name}" %>

<p style="margin:24px 0 0 0;">
  Cheers, <br />
  The <%= @doubtfire_product_name %> Team on behalf of <%= @tutor.name %>
</p>

<% content_for :footer do %>
  <p style="margin:0;">
    <a href="<%= @unsubscribe_url %>" style="color:#6b7280; text-decoration:underline;">Unsubscribe</a> | Generated with <%= @doubtfire_product_name %>
  </p>
<% end %>
