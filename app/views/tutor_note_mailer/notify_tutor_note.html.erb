<% content_for :icon do %>comment<% end %>
<% content_for :preheader do %>A new tutor note from <%= @from.name %> in <%= @unit.name %>.<% end %>
<% content_for :heading do %>New tutor note<% end %>
<% content_for :subheading do %><%= @unit.name %><% end %>

<p style="margin:0 0 20px 0;">Hi <%= @recipient.first_name %>,</p>

<%= render 'layouts/notification_mail/details', body: simple_format(@note.note, style: 'margin:0 0 8px 0;'), category: 'comment', label: "From #{@from.name}" %>

<% if @task.present? %>
  <%= render 'layouts/notification_mail/facts', rows: [
        ['Task', "#{@task.task_definition.abbreviation} - #{@task.task_definition.name}"],
        ['Student', @task.project.user.name]
      ] %>
  <%= render 'layouts/notification_mail/button', url: "#{@doubtfire_host}/units/#{@task.project.unit_id}/tasks/definition/#{@task.project.user.id}/#{ERB::Util.url_encode(@task.task_definition.abbreviation)}", label: 'View the task' %>
<% else %>
  <%= render 'layouts/notification_mail/button', url: @doubtfire_host, label: "Open #{@doubtfire_product_name}" %>
<% end %>

<% if @recipient == @unit.unit_role_for(@from)&.mentor&.user %>
  <%= render 'layouts/notification_mail/note', body: "You are receiving this because you are #{@from.name}'s mentor." %>
<% else %>
  <%= render 'layouts/notification_mail/note', body: "You are receiving this because #{@from.name} is your mentor." %>
<% end %>

<p style="margin:24px 0 0 0;">
  Cheers,<br/>
  The <%= @doubtfire_product_name %> Team on behalf of <%= @from.name %>
</p>

<% content_for :footer do %>
  <p style="margin:0;">
    <a href="<%= @unsubscribe_url %>" style="color:#6b7280; text-decoration:underline;">Unsubscribe</a> | Generated with <%= @doubtfire_product_name %>
  </p>
<% end %>
