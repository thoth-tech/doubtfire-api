<% content_for :icon do %>announcement<% end %>
<% content_for :preheader do %><%= @body_paragraphs.first.to_s.truncate(90) %><% end %>
<% content_for :heading do %>A message from <%= @sender&.name.presence || @doubtfire_product_name %><% end %>
<% if @unit&.name.present? %><% content_for :subheading do %><%= @unit.name %><% end %><% end %>

<p style="margin:0 0 20px 0;">Hi <%= @recipient&.nickname.presence || @recipient&.first_name %>,</p>

<%# The convenor wrote this body. Lead with the first paragraph in the callout
    so the point of the message survives a glance, and leave the rest as prose
    because it is theirs to shape, not this template's. %>
<% if @body_paragraphs.any? %>
  <%= render 'layouts/notification_mail/details', body: @body_paragraphs.first, category: 'announcement' %>
<% end %>

<% @body_paragraphs.drop(1).each do |paragraph| %>
  <p style="margin:0 0 16px 0;"><%= paragraph %></p>
<% end %>

<p style="margin:24px 0 0 0;">
  Cheers, <br />
  The <%= @doubtfire_product_name %> Team on behalf of <%= @sender&.name %>
</p>

<% content_for :footer do %>
  <p style="margin:0;">
    <a href="<%= @unsubscribe_url %>" style="color:#6b7280; text-decoration:underline;">Unsubscribe</a> | Generated with <%= @doubtfire_product_name %>
  </p>
<% end %>
