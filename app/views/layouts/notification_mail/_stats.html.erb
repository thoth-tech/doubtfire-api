<%# Rows of one number and what it means, the figure first, so a recipient can
    find the one they care about without reading all of them.
    Takes [value, label] pairs, or [value, label, accent] where the figure is
    worth colouring: a count sitting with a tutor gets the ready-for-feedback
    blue it has on the task itself. %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px 0; border-collapse:collapse; border:1px solid #e5e7eb; border-radius:6px;">
  <% rows.each_with_index do |(value, label, accent), index| %>
    <tr>
      <td align="right" valign="top" width="64" style="width:64px; padding:10px 14px 10px 16px; <%= 'border-top:1px solid #e5e7eb;' unless index.zero? %> font-size:18px; line-height:1.3; font-weight:700; color:<%= accent.presence || '#111827' %>;"><%= value %></td>
      <td valign="top" style="padding:12px 16px 10px 0; <%= 'border-top:1px solid #e5e7eb;' unless index.zero? %> font-size:14px; line-height:1.4; color:#4b5563;"><%= label %></td>
    </tr>
  <% end %>
</table>
